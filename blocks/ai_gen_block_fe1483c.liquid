{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-customer-reviews-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-customer-reviews__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.spacing_between_elements }}px;
  }

  .ai-customer-reviews__title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.spacing_between_elements | divided_by: 2 }}px;
  }

  /* --- Styles du Carrousel --- */
  .ai-customer-reviews__slider-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .ai-customer-reviews__grid-{{ ai_gen_id }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: {{ block.settings.grid_gap }}px;
    padding-bottom: 10px;
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }

  .ai-customer-reviews__grid-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
  }

  .ai-customer-reviews__item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.columns_desktop | minus: 1 }} * {{ block.settings.grid_gap }}px)) / {{ block.settings.columns_desktop }});
    scroll-snap-align: start;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.card_inner_spacing }}px;
    box-sizing: border-box;
  }

  /* --- Navigation --- */
  .ai-carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: white;
    border: 1px solid #ddd;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }

  .ai-carousel-nav--prev { left: 10px; }
  .ai-carousel-nav--next { right: 10px; }
  
  .ai-carousel-nav svg { width: 20px; height: 20px; }

  /* --- Suite des styles d'origine --- */
  .ai-customer-reviews__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-customer-reviews__image-{{ ai_gen_id }} { width: 100%; height: 100%; object-fit: cover; }

  .ai-customer-reviews__rating-{{ ai_gen_id }} {
    display: flex; gap: 4px; justify-content: {{ block.settings.text_alignment }};
  }

  .ai-customer-reviews__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px; height: {{ block.settings.star_size }}px; color: {{ block.settings.star_color }};
  }

  .ai-customer-reviews__star-{{ ai_gen_id }}--empty { color: {{ block.settings.star_empty_color }}; }

  .ai-customer-reviews__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.review_text_size }}px;
    line-height: 1.6;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-customer-reviews__author-{{ ai_gen_id }} {
    display: flex; align-items: center; gap: 12px; margin-top: auto;
  }

  .ai-customer-reviews__avatar-{{ ai_gen_id }}, .ai-customer-reviews__avatar-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px; height: {{ block.settings.avatar_size }}px; border-radius: 50%; flex-shrink: 0;
  }
  
  .ai-customer-reviews__author-name-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }}; font-weight: 600; font-size: {{ block.settings.author_name_size }}px; margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-customer-reviews__item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.columns_mobile | minus: 1 }} * {{ block.settings.grid_gap }}px)) / {{ block.settings.columns_mobile }});
    }
    .ai-carousel-nav { display: none; } /* On cache les flèches sur mobile pour laisser le swipe naturel */
  }
{% endstyle %}

<customer-reviews-{{ ai_gen_id }} class="ai-customer-reviews-{{ ai_gen_id }}" 
  data-autoplay="{{ block.settings.autoplay }}" 
  data-speed="{{ block.settings.autoplay_speed | times: 1000 }}"
  {{ block.shopify_attributes }}>
  
  {% if block.settings.heading != blank or block.settings.subtitle != blank %}
    <div class="ai-customer-reviews__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-customer-reviews__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-customer-reviews__slider-wrapper">
    <button class="ai-carousel-nav ai-carousel-nav--prev" aria-label="Précédent">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>

    <div class="ai-customer-reviews__grid-{{ ai_gen_id }} js-slider">
      {% for i in (1..6) %}
        {% liquid
          assign text_key = 'review_' | append: i | append: '_text'
          assign name_key = 'review_' | append: i | append: '_name'
          if block.settings[text_key] == blank and i > 3
            continue
          endif
          
          assign image_key = 'review_' | append: i | append: '_image'
          assign rating_key = 'review_' | append: i | append: '_rating'
          assign avatar_key = 'review_' | append: i | append: '_avatar'
        %}

        <div class="ai-customer-reviews__item-{{ ai_gen_id }}">
          {% if block.settings.show_images %}
            <div class="ai-customer-reviews__image-wrapper-{{ ai_gen_id }}">
              {% if block.settings[image_key] %}
                <img src="{{ block.settings[image_key] | image_url: width: 600 }}" alt="Review" class="ai-customer-reviews__image-{{ ai_gen_id }}" loading="lazy">
              {% else %}
                <div style="background:#eee; width:100%; height:100%; display:flex; align-items:center; justify-content:center;">Image</div>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.show_rating %}
            <div class="ai-customer-reviews__rating-{{ ai_gen_id }}">
              {% for star in (1..5) %}
                <svg class="ai-customer-reviews__star-{{ ai_gen_id }} {% if star > block.settings[rating_key] %}ai-customer-reviews__star-{{ ai_gen_id }}--empty{% endif %}" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% endfor %}
            </div>
          {% endif %}

          <div class="ai-customer-reviews__text-{{ ai_gen_id }}">{{ block.settings[text_key] }}</div>

          <div class="ai-customer-reviews__author-{{ ai_gen_id }}">
            <div class="ai-customer-reviews__author-info-{{ ai_gen_id }}">
              <div class="ai-customer-reviews__author-name-{{ ai_gen_id }}">{{ block.settings[name_key] }}</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <button class="ai-carousel-nav ai-carousel-nav--next" aria-label="Suivant">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>
</customer-reviews-{{ ai_gen_id }}>

<script>
  if (!customElements.get('customer-reviews-{{ ai_gen_id }}')) {
    customElements.define('customer-reviews-{{ ai_gen_id }}', class extends HTMLElement {
      connectedCallback() {
        const slider = this.querySelector('.js-slider');
        const prevBtn = this.querySelector('.ai-carousel-nav--prev');
        const nextBtn = this.querySelector('.ai-carousel-nav--next');
        const scrollAmount = () => slider.querySelector('div').offsetWidth + parseInt(getComputedStyle(slider).gap);

        prevBtn.addEventListener('click', () => slider.scrollBy({ left: -scrollAmount(), behavior: 'smooth' }));
        nextBtn.addEventListener('click', () => slider.scrollBy({ left: scrollAmount(), behavior: 'smooth' }));

        if (this.dataset.autoplay === 'true') {
          setInterval(() => {
            if (slider.scrollLeft + slider.offsetWidth >= slider.scrollWidth) {
              slider.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
              slider.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
            }
          }, parseInt(this.dataset.speed));
        }
      }
    });
  }
</script>

{% schema %}
{
  "name": "Avis clients Carrousel",
  "settings": [
    { "type": "header", "content": "Configuration Carrousel" },
    { "type": "checkbox", "id": "autoplay", "label": "Défilement automatique", "default": false },
    { "type": "range", "id": "autoplay_speed", "label": "Vitesse (secondes)", "min": 2, "max": 10, "step": 1, "default": 5 },
    { "type": "header", "content": "Mise en page" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Avis Clients" },
    { "type": "range", "id": "columns_desktop", "label": "Avis visibles (Desktop)", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "columns_mobile", "label": "Avis visibles (Mobile)", "options": [{"value":"1","label":"1"},{"value":"2","label":"2"}], "default": "1" },
    { "type": "range", "id": "desktop_width_percent", "label": "Largeur section", "min": 70, "max": 100, "default": 100 },
    { "type": "range", "id": "grid_gap", "label": "Espace entre avis", "min": 10, "max": 40, "default": 20 },
    { "type": "range", "id": "section_padding", "label": "Padding section", "min": 0, "max": 100, "default": 40 },
    { "type": "range", "id": "card_padding", "label": "Padding carte", "min": 10, "max": 50, "default": 20 },
    { "type": "range", "id": "heading_size", "label": "Taille titre", "min": 20, "max": 50, "default": 30 },
    { "type": "select", "id": "text_alignment", "label": "Alignement", "options": [{"value":"left","label":"Gauche"},{"value":"center","label":"Centre"}], "default": "center" },
    { "type": "select", "id": "image_aspect_ratio", "label": "Format image", "options": [{"value":"1/1","label":"Carré"},{"value":"16/9","label":"16:9"}], "default": "16/9" },
    { "type": "checkbox", "id": "show_images", "label": "Afficher images", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Afficher étoiles", "default": true },
    { "type": "color", "id": "background_color", "label": "Fond section", "default": "#ffffff" },
    { "type": "color", "id": "card_background", "label": "Fond carte", "default": "#f4f4f4" },
    { "type": "color", "id": "star_color", "label": "Couleur étoiles", "default": "#ffcc00" },
    { "type": "header", "content": "Avis 1" },
    { "type": "image_picker", "id": "review_1_image", "label": "Image" },
    { "type": "range", "id": "review_1_rating", "label": "Note", "min": 1, "max": 5, "default": 5 },
    { "type": "textarea", "id": "review_1_text", "label": "Texte", "default": "Super produit !" },
    { "type": "text", "id": "review_1_name", "label": "Nom", "default": "Julie" },
    { "type": "header", "content": "Avis 2" },
    { "type": "image_picker", "id": "review_2_image", "label": "Image" },
    { "type": "range", "id": "review_2_rating", "label": "Note", "min": 1, "max": 5, "default": 5 },
    { "type": "textarea", "id": "review_2_text", "label": "Texte", "default": "Génial !" },
    { "type": "text", "id": "review_2_name", "label": "Nom", "default": "Marc" },
    { "type": "header", "content": "Avis 3" },
    { "type": "image_picker", "id": "review_3_image", "label": "Image" },
    { "type": "range", "id": "review_3_rating", "label": "Note", "min": 1, "max": 5, "default": 4 },
    { "type": "textarea", "id": "review_3_text", "label": "Texte", "default": "Très bon service." },
    { "type": "text", "id": "review_3_name", "label": "Nom", "default": "Sophie" }
  ],
  "presets": [{ "name": "Avis clients Carrousel" }]
}
{% endschema %}