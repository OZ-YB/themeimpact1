{% doc %}
  @prompt
    a partir du bloc "avis clients" du dessous, génére des avis clients qui défilent sous forme de carroussel
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-carousel-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    position: relative;
    padding: 40px 0;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-reviews-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
    padding: 0 20px;
  }

  .ai-reviews-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
  }

  .ai-reviews-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-reviews-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    animation: ai-reviews-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-reviews-carousel__track-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  .ai-reviews-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 24px;
    box-shadow: 0 {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-reviews-carousel__rating-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-reviews-carousel__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
  }

  .ai-reviews-carousel__star-{{ ai_gen_id }}--empty {
    color: {{ block.settings.star_empty_color }};
  }

  .ai-reviews-carousel__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    flex-grow: 1;
  }

  .ai-reviews-carousel__author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-reviews-carousel__avatar-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.avatar_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    color: {{ block.settings.avatar_text_color }};
    font-size: 16px;
    flex-shrink: 0;
  }

  .ai-reviews-carousel__author-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-reviews-carousel__author-name-{{ ai_gen_id }} {
    font-weight: 600;
    font-size: 14px;
    color: {{ block.settings.title_color }};
  }

  .ai-reviews-carousel__author-date-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  @keyframes ai-reviews-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-{{ block.settings.card_width }}px - 24px) * 6);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 280px;
    }

    @keyframes ai-reviews-scroll-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-280px - 24px) * 6);
      }
    }
  }
{% endstyle %}

<div class="ai-reviews-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.subtitle != blank %}
    <div class="ai-reviews-carousel__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-reviews-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-reviews-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-reviews-carousel__track-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign review_text_key = 'review_' | append: i | append: '_text'
        assign review_name_key = 'review_' | append: i | append: '_name'
        assign review_date_key = 'review_' | append: i | append: '_date'
        assign review_rating_key = 'review_' | append: i | append: '_rating'

        assign review_text = block.settings[review_text_key]
        assign review_name = block.settings[review_name_key]
        assign review_date = block.settings[review_date_key]
        assign review_rating = block.settings[review_rating_key]
      %}

      <div class="ai-reviews-carousel__card-{{ ai_gen_id }}">
        <div class="ai-reviews-carousel__rating-{{ ai_gen_id }}">
          {% for star in (1..5) %}
            {% if star <= review_rating %}
              <svg class="ai-reviews-carousel__star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% else %}
              <svg class="ai-reviews-carousel__star-{{ ai_gen_id }} ai-reviews-carousel__star-{{ ai_gen_id }}--empty" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endif %}
          {% endfor %}
        </div>

        <div class="ai-reviews-carousel__text-{{ ai_gen_id }}">
          {{ review_text }}
        </div>

        <div class="ai-reviews-carousel__author-{{ ai_gen_id }}">
          <div class="ai-reviews-carousel__avatar-{{ ai_gen_id }}">
            {{ review_name | slice: 0 }}
          </div>
          <div class="ai-reviews-carousel__author-info-{{ ai_gen_id }}">
            <div class="ai-reviews-carousel__author-name-{{ ai_gen_id }}">{{ review_name }}</div>
            <div class="ai-reviews-carousel__author-date-{{ ai_gen_id }}">{{ review_date }}</div>
          </div>
        </div>
      </div>
    {% endfor %}

    {% for i in (1..6) %}
      {% liquid
        assign review_text_key = 'review_' | append: i | append: '_text'
        assign review_name_key = 'review_' | append: i | append: '_name'
        assign review_date_key = 'review_' | append: i | append: '_date'
        assign review_rating_key = 'review_' | append: i | append: '_rating'

        assign review_text = block.settings[review_text_key]
        assign review_name = block.settings[review_name_key]
        assign review_date = block.settings[review_date_key]
        assign review_rating = block.settings[review_rating_key]
      %}

      <div class="ai-reviews-carousel__card-{{ ai_gen_id }}">
        <div class="ai-reviews-carousel__rating-{{ ai_gen_id }}">
          {% for star in (1..5) %}
            {% if star <= review_rating %}
              <svg class="ai-reviews-carousel__star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% else %}
              <svg class="ai-reviews-carousel__star-{{ ai_gen_id }} ai-reviews-carousel__star-{{ ai_gen_id }}--empty" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endif %}
          {% endfor %}
        </div>

        <div class="ai-reviews-carousel__text-{{ ai_gen_id }}">
          {{ review_text }}
        </div>

        <div class="ai-reviews-carousel__author-{{ ai_gen_id }}">
          <div class="ai-reviews-carousel__avatar-{{ ai_gen_id }}">
            {{ review_name | slice: 0 }}
          </div>
          <div class="ai-reviews-carousel__author-info-{{ ai_gen_id }}">
            <div class="ai-reviews-carousel__author-name-{{ ai_gen_id }}">{{ review_name }}</div>
            <div class="ai-reviews-carousel__author-date-{{ ai_gen_id }}">{{ review_date }}</div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

